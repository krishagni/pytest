OS_DOMAIN_NAME=openspecimen

# ─── Framework Fields ─────────────────────────────────────────────────────────
META_FIELDS=["TC_ID", "TC_Description", "Expected_Result", "Role", "Operation", "Author"]


# ─── Security Framework Fields ─────────────────────────────────────────────────
# ─── Security Test Settings ────────────────────────────────────────────────────
