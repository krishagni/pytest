# Base name for security output CSV (timestamp is auto-appended)
SECURITY_OUTPUT_FILE=security_output.csv

# ─── Security Framework Fields ─────────────────────────────────────────────────
SECURITY_META_FIELDS=["TC_ID", "TC_Description", "Operation", "Endpoint", "Expected_Result", "File_Info", "Comments", "Role"]
SECURITY_OUTPUT_EXTRA=["TC_Status", "HTTP_Status_Code", "Security_Assertion", "Reflected_Input_Found", "Error_Details", "Latency_ms"]
