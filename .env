# ─── OpenSpecimen ─────────────────────────────────────────────────────────────
OS_BASE_URL=https://test.openspecimen.org/rest/ng

# ─── Test Settings ────────────────────────────────────────────────────────────
INPUT_FILE=input_participants.csv  # comment out Gsheet and takes the default - > input participant file for processing 
OUTPUT_FILE=output_results.csv
MASTER_GSHEET_ID=15Day-53kkDxvtZk2lmLBqWP5T-Hd7cQ0cz4AG3KMctY
MASTER_GSHEET_SUMMARY_GID=345736693
ROLES_GSHEET_GID=1147799688

# ─── Cleanup ──────────────────────────────────────────────────────────────────
CLEANUP_RESOURCES=true

# ─── Snapshot (optional) ──────────────────────────────────────────────────────
SAVE_INPUT_SNAPSHOT=false
SNAPSHOT_DIR=input_snapshots

# ─── Framework Fields ─────────────────────────────────────────────────────────
META_FIELDS=["TC_ID", "TC_Description", "Expected_Result", "Role", "Operation"]
OUTPUT_EXTRA=["TC_Status", "Validation_Status", "Validation_Diff", "Error_Received", "HTTP_Status_Code", "Latency_ms"]

# ─── Security Test Settings ────────────────────────────────────────────────────
# Option A: Full export URL to your security GSheet tab
SECURITY_GSHEET_URL=

# Option B: GID of the Security tab inside your existing MASTER_GSHEET_ID sheet
# (Leave SECURITY_GSHEET_URL blank and fill this instead)
SECURITY_GSHEET_GID=

# Folder that holds per-TC payload sub-folders (TC_XSS_01/, TC_SQL_01/, etc.)
SECURITY_TC_DATA_DIR=security_tests/tc_data

# Base name for the security output CSV (timestamp is auto-appended)
SECURITY_OUTPUT_FILE=security_output.csv

# Bulk-import endpoint (override if your instance uses a different path)
# BULK_IMPORT_URL=https://test.openspecimen.org/rest/ng/bulk-imports