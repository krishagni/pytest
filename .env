MASTER_GSHEET_SUMMARY_GID=345736693
ROLES_GSHEET_GID=1147799688

# ─── Cleanup ──────────────────────────────────────────────────────────────────
CLEANUP_RESOURCES=true

# ─── Snapshot (optional) ──────────────────────────────────────────────────────
SAVE_INPUT_SNAPSHOT=false
SNAPSHOT_DIR=input_snapshots

# ─── Auth ──────────────────────────────────────────────────────────────────────
OS_LOGIN_NAME=rohit@krishagni.com
