# ── Dynamic Field Definitions ────────────────────────────────────────────────
STATUS_FLD=TC_Status
VALID_STAT_FLD=Validation_Status
ERR_FLD=Error_Received
HTTP_CODE_FLD=HTTP_Status_Code
